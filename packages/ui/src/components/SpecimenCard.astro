---
import LabelPlate from './LabelPlate.astro';

export interface Props {
  id: string;
  year: string | number;
  status: 'shipped' | 'in-lab';
  stack: string[];
  title: string;
  description: string;
}

const { id, year, status, stack, title, description } = Astro.props;
---

<article class="flex flex-col gap-4 rounded-lg border border-border-paper bg-paper p-card text-ink">
  <div>
    <h3 class="font-sans text-2xl font-semibold">{title}</h3>
    <p class="mt-2 text-sm text-ink/70">{description}</p>
  </div>

  <div class="min-h-32 rounded-md border border-dashed border-border-paper bg-ink/[0.03] p-4">
    <slot name="demo">
      <div class="flex h-full min-h-24 items-center justify-center font-mono text-xs uppercase tracking-widest text-ink/40">
        demo area
      </div>
    </slot>
  </div>

  <LabelPlate id={id} year={year} status={status} stack={stack} />
</article>
