---
import LabelPlate from './LabelPlate.astro';

export interface Props {
  id: string;
  year: string | number;
  status: 'shipped' | 'in-lab';
  stack: string[];
  title: string;
  description: string;
  href?: string;
  linkLabel?: string;
}

const { id, year, status, stack, title, description, href, linkLabel } = Astro.props;
---

<article
  class:list={[
    'flex flex-col gap-4 rounded-lg border border-border-paper bg-paper p-card text-ink',
    href && 'relative',
  ]}
>
  <div>
    <h3 class="font-sans text-2xl font-semibold">
      {
        href ? (
          <a
            href={href}
            aria-label={linkLabel}
            class="outline-none after:absolute after:inset-0 after:z-0 after:rounded-lg after:content-[''] focus-visible:after:outline-2 focus-visible:after:outline-accent focus-visible:after:outline-offset-2"
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <p class="mt-2 text-sm text-ink/70">{description}</p>
  </div>

  <div
    class:list={[
      'min-h-32 rounded-md border border-dashed border-border-paper bg-ink/[0.03] p-4',
      href && 'relative z-10',
    ]}
  >
    <slot name="demo">
      <div class="flex h-full min-h-24 items-center justify-center font-mono text-xs uppercase tracking-widest text-ink/40">
        demo area
      </div>
    </slot>
  </div>

  <LabelPlate id={id} year={year} status={status} stack={stack} />
</article>
