---
export interface Props {
  status: 'shipped' | 'in-lab';
}

const { status } = Astro.props;
const label = status === 'shipped' ? 'SHIPPED' : 'IN THE LAB';
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-sm border px-2 py-0.5 font-mono text-xs tracking-wider uppercase',
    status === 'shipped'
      ? 'border-border-paper text-ink/70'
      : 'border-accent/40 text-accent',
  ]}
>
  <span
    class:list={[
      'h-1.5 w-1.5 rounded-full',
      status === 'shipped' ? 'bg-ink/50' : 'bg-accent',
    ]}
    aria-hidden="true"
  ></span>
  {label}
</span>
