---
export interface Props {
  variant?: 'primary' | 'ghost';
  href?: string;
}

const { variant = 'primary', href, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';

const base =
  'inline-flex items-center justify-center gap-2 rounded-sm px-4 py-2 font-sans text-sm font-medium transition-colors outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';

const variants = {
  primary: 'bg-accent text-ink hover:bg-accent-hover',
  ghost: 'border border-border text-paper hover:border-accent hover:text-accent',
};
---

<Tag class:list={[base, variants[variant]]} href={href} {...rest}>
  <slot />
</Tag>
