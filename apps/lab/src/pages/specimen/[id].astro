---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecimenLayout from '../../components/SpecimenLayout.astro';
import { wiredDemoIds } from '../../lib/demos';

export async function getStaticPaths() {
	const specimens = await getCollection('specimens');
	return specimens
		.filter((specimen) => !wiredDemoIds.includes(specimen.id) && specimen.data.status !== 'course')
		.map((specimen) => ({
			params: { id: specimen.id },
			props: { specimen },
		}));
}

const { specimen } = Astro.props;
const { Content } = await render(specimen);
const { title, tagline, year, stack, status, specimenId, repoUrl, liveUrl, role } = specimen.data;
---

<BaseLayout title={`${title} - The Lab`} description={tagline}>
	<SpecimenLayout
		title={title}
		tagline={tagline}
		specimenId={specimenId}
		year={year}
		status={status}
		stack={stack}
		role={role}
		repoUrl={repoUrl}
		liveUrl={liveUrl}
	>
		<Fragment slot="content"><Content /></Fragment>
		<section id="demo" class="mx-auto mt-16 max-w-3xl px-6 pb-16 sm:px-8">
			<div class="rounded-lg border border-dashed border-border p-8">
				<p class="font-mono text-xs uppercase tracking-widest text-muted">
					No live demo yet. The write-up above covers how it works.
				</p>
			</div>
		</section>
	</SpecimenLayout>
</BaseLayout>
