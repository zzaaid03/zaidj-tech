---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabelPlate from '@zaidj/ui/components/LabelPlate.astro';
import Button from '@zaidj/ui/components/Button.astro';
import UniPlanDemo from '@zaidj/demos/uni-plan/UniPlanDemo.tsx';
import LazStoreDemo from '@zaidj/demos/laz-store/LazStoreDemo.tsx';
import BrewitDemo from '@zaidj/demos/brewit/BrewitDemo.tsx';
import LifeOsDemo from '@zaidj/demos/life-os/LifeOsDemo.tsx';

export async function getStaticPaths() {
	const specimens = await getCollection('specimens');
	return specimens.map((specimen) => ({
		params: { id: specimen.id },
		props: { specimen },
	}));
}

const { specimen } = Astro.props;
const { Content } = await render(specimen);
const { title, tagline, year, stack, status, specimenId, repoUrl, liveUrl, role } = specimen.data;
---

<BaseLayout title={`${title} - The Lab`} description={tagline}>
	<article class="mx-auto max-w-3xl px-6 pt-16 sm:px-8">
		<a href="/" class="font-mono text-xs uppercase tracking-widest text-muted hover:text-accent">
			&larr; Back to The Lab
		</a>

		<h1 class="mt-6 font-sans text-4xl font-semibold text-paper sm:text-5xl">{title}</h1>
		<p class="mt-3 max-w-xl text-lg text-muted">{tagline}</p>

		<div class="mt-8 rounded-lg border border-border-paper bg-paper p-card text-ink">
			<LabelPlate id={specimenId} year={year} status={status} stack={stack} />
		</div>

		<div class="mt-8">
			<h2 class="font-mono text-xs uppercase tracking-widest text-muted">What I built</h2>
			<p class="mt-2 max-w-xl text-paper">{role}</p>
		</div>

		<div class="mt-8 max-w-xl space-y-4 text-sm leading-relaxed text-muted">
			<Content />
		</div>

		<div class="mt-10 flex flex-wrap gap-4">
			<Button variant="primary" href={repoUrl}>View repo</Button>
			{liveUrl && (
				<Button variant="ghost" href={liveUrl}>
					Visit live site
				</Button>
			)}
		</div>
	</article>

	{specimen.id === 'uni-plan' ? (
		<section id="demo" class="mx-auto mt-16 max-w-4xl px-6 pb-16 sm:px-8">
			<h2 class="font-mono text-xs uppercase tracking-widest text-muted">Live demo</h2>
			<div class="mt-2">
				<UniPlanDemo client:visible />
			</div>
		</section>
	) : specimen.id === 'laz-store' ? (
		<section id="demo" class="mx-auto mt-16 max-w-4xl px-6 pb-16 sm:px-8">
			<h2 class="font-mono text-xs uppercase tracking-widest text-muted">Live demo</h2>
			<div class="mt-2">
				<LazStoreDemo client:visible />
			</div>
		</section>
	) : specimen.id === 'brewit' ? (
		<section id="demo" class="mx-auto mt-16 max-w-4xl px-6 pb-16 sm:px-8">
			<h2 class="font-mono text-xs uppercase tracking-widest text-muted">Live demo</h2>
			<div class="mt-2">
				<BrewitDemo client:visible />
			</div>
		</section>
	) : specimen.id === 'life-os' ? (
		<section id="demo" class="mx-auto mt-16 max-w-4xl px-6 pb-16 sm:px-8">
			<h2 class="font-mono text-xs uppercase tracking-widest text-muted">Live demo</h2>
			<div class="mt-2">
				<LifeOsDemo client:visible />
			</div>
		</section>
	) : (
		<section id="demo" class="mx-auto mt-16 max-w-3xl px-6 pb-16 sm:px-8">
			<div class="rounded-lg border border-dashed border-border p-8">
				<p class="font-mono text-xs uppercase tracking-widest text-muted">
					No live demo yet. The write-up above covers how it works.
				</p>
			</div>
		</section>
	)}
</BaseLayout>
