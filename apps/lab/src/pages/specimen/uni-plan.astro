---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecimenLayout from '../../components/SpecimenLayout.astro';
import UniPlanDemo from '@zaidj/demos/uni-plan/UniPlanDemo.tsx';

const specimens = await getCollection('specimens');
const specimen = specimens.find((entry) => entry.id === 'uni-plan')!;
const { Content } = await render(specimen);
const { title, tagline, year, stack, status, specimenId, repoUrl, liveUrl, role } = specimen.data;
---

<BaseLayout title={`${title} - The Lab`} description={tagline}>
	<SpecimenLayout
		title={title}
		tagline={tagline}
		specimenId={specimenId}
		year={year}
		status={status}
		stack={stack}
		role={role}
		repoUrl={repoUrl}
		liveUrl={liveUrl}
	>
		<Fragment slot="content"><Content /></Fragment>
		<section id="demo" class="mx-auto mt-16 max-w-4xl px-6 pb-16 sm:px-8">
			<h2 class="font-mono text-xs uppercase tracking-widest text-muted">Live demo</h2>
			<div class="mt-2">
				<UniPlanDemo client:visible />
			</div>
		</section>
	</SpecimenLayout>
</BaseLayout>
