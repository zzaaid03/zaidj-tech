---
import '../../styles/global.css';
import UniPlanDemo from '@zaidj/demos/uni-plan/UniPlanDemo.tsx';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Uni-Plan demo — The Lab</title>
	</head>
	<body>
		<main class="mx-auto max-w-4xl px-gutter py-section">
			<h1 class="font-sans text-3xl font-semibold text-paper">Uni-Plan</h1>
			<p class="mt-2 max-w-prose text-paper/70">
				Add courses, toggle them on and off, and watch schedule conflicts and predicted GPA
				update live — the same conflict-detection and GPA logic from the real Uni-Plan app,
				running entirely in your browser.
			</p>
			<div class="mt-gutter">
				<UniPlanDemo client:visible />
			</div>
		</main>
	</body>
</html>
